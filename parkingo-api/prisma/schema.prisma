// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id    String @id @default(uuid())
  name  String @unique
  roles Role[]
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  INACTIVE
  SUSPENDED
  DELETED
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserGender {
  M
  F
  U
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  password   String
  isVerified Boolean     @default(false)
  status     UserStatus  @default(ACTIVE)
  photoUrl   String?
  firstName  String
  lastName   String
  gender     UserGender?
  birthDate  DateTime?   @db.Date
  ci         String      @unique
  phone      String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdById  String?
  createdBy    User?   @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserHierarchy")

  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?

  verificationTokens    EmailVerificationToken[]
  verificationDocuments UserVerificationDocument[]
  tenants               Tenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserVerificationDocument {
  id              String                     @id @default(uuid())
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String                     @default("application/pdf")
  status          DocumentVerificationStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([userId])
  @@map("user_verification_documents")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model TerminoCondicion {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  version   String   @default("1.0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("terminos_condiciones")
}

enum TenantStatus {
  ACTIVO
  INACTIVO
}

model Tenant {
  id          String       @id @default(uuid())
  nombre      String
  nit         String       @unique
  razonSocial String
  estado      TenantStatus @default(ACTIVO)

  direccion   String?
  ciudad      String?
  latitud     Float?
  longitud    Float?

  usuarioId   String
  usuario     User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  estacionamiento Estacionamiento?
  horarios        Horario[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([usuarioId])
  @@map("tenants")
}

enum EstadoEstacionamiento {
  PENDIENTE
  APROBADO
  RECHAZADO
  INHABILITADO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Estacionamiento {
  id              String                @id @default(uuid())
  nombre          String
  direccion       String
  longitud        Float
  latitud         Float
  estado          EstadoEstacionamiento @default(PENDIENTE)

  tenantId        String                @unique @map("tenant_id")
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  motivoRechazo   String?               @map("motivo_rechazo") @db.Text
  fechaAprobacion DateTime?             @map("fecha_aprobacion")

  fotos           FotoEstacionamiento[]
  horarios        EstacionamientoHorario[]
  serviciosExtras ServicioExtra[]
  tarifas         Tarifa[]
  niveles         Nivel[]

  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@map("estacionamientos")
}

model FotoEstacionamiento {
  id                String          @id @default(uuid())
  url               String
  estacionamientoId String          @map("estacionamiento_id")
  estacionamiento   Estacionamiento @relation(fields: [estacionamientoId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([estacionamientoId])
  @@map("fotos")
}

model Horario {
  id               String                   @id @default(uuid())
  dia              DiaSemana
  horaInicio       String                   @map("hora_inicio")
  horaCierre       String                   @map("hora_cierre")

  tenantId         String                   @map("tenant_id")
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  estacionamientos EstacionamientoHorario[]

  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@unique([tenantId, dia, horaInicio, horaCierre])
  @@index([tenantId])
  @@map("horarios")
}

model EstacionamientoHorario {
  id                String          @id @default(uuid())

  estacionamientoId String          @map("estacionamiento_id")
  estacionamiento   Estacionamiento @relation(fields: [estacionamientoId], references: [id], onDelete: Cascade)

  horarioId         String          @map("horario_id")
  horario           Horario         @relation(fields: [horarioId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([estacionamientoId, horarioId])
  @@index([estacionamientoId])
  @@index([horarioId])
  @@map("estacionamientos_horarios")
}

model ServicioExtra {
  id                String          @id @default(uuid())
  nombre            String
  descripcion       String?         @db.Text
  precio            Float
  activo            Boolean         @default(true)

  estacionamientoId String          @map("estacionamiento_id")
  estacionamiento   Estacionamiento @relation(fields: [estacionamientoId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([estacionamientoId])
  @@map("servicios_extras")
}

enum ModalidadTarifa {
  HORA
  DIA
  MES
}

enum EstadoTarifa {
  ACTIVO
  INACTIVO
}

model Tarifa {
  id                String          @id @default(uuid())
  descripcion       String          @db.Text
  monto             Float
  modalidad         ModalidadTarifa
  estado            EstadoTarifa    @default(ACTIVO)

  estacionamientoId String          @map("estacionamiento_id")
  estacionamiento   Estacionamiento @relation(fields: [estacionamientoId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([estacionamientoId])
  @@map("tarifas")
}

enum TipoEspacio {
  AUTO
  MOTO
  CAMIONETA
  DISCAPACITADO
  ELECTRICO
}

enum EstadoEspacio {
  DISPONIBLE
  OCUPADO
  RESERVADO
  MANTENIMIENTO
}

model Nivel {
  id                String          @id @default(uuid())
  codigo            String
  estacionamientoId String          @map("estacionamiento_id")
  estacionamiento   Estacionamiento @relation(fields: [estacionamientoId], references: [id], onDelete: Cascade)

  espacios          Espacio[]
  croquis           Croquis[]

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([estacionamientoId, codigo])
  @@index([estacionamientoId])
  @@map("niveles")
}

model Espacio {
  id            String          @id @default(uuid())
  codigoEspacio String          @map("codigo_espacio")
  tipo          TipoEspacio     @default(AUTO)
  modalidad     ModalidadTarifa @default(HORA)
  estado        EstadoEspacio   @default(DISPONIBLE)

  nivelId       String          @map("nivel_id")
  nivel         Nivel           @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([nivelId, codigoEspacio])
  @@index([nivelId])
  @@map("espacios")
}

model Croquis {
  id        String   @id @default(uuid())
  codigo    String
  nivelId   String   @map("nivel_id")
  nivel     Nivel    @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nivelId])
  @@map("croquis")
}
